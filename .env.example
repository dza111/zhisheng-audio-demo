DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
HOST=127.0.0.1
PORT=4173
# Production: use your exact site origin, without a trailing slash.
ALLOWED_ORIGINS=https://your-domain.example
# Basic per-IP protection for the public chat endpoint.
RATE_LIMIT=15
RATE_WINDOW_SECONDS=60
MIX_EXECUTION_MODE=manual
MIX_AGENT_TOKEN=replace-with-a-long-random-agent-token
MIX_MAX_FILE_SIZE_MB=100
MIX_MAX_FILES=4
# Optional. Defaults to ./data and is intentionally ignored by Git.
MIX_DATA_DIR=data
